@'
# Application Ports
PORT=5000
FRONTEND_PORT=5173

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=habesha_fit_db
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/habesha_fit_db?schema=public"

# Security
JWT_SECRET=your_jwt_secret_key_here
'@ | Set-Content -Path .env.example -Encoding utf8